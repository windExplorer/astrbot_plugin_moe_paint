# 打包产物（只增不删，但不入库）
dist/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# 前端
node_modules/
# 构建时由 build_webui.ps1 从 metadata.yaml 注入，不入库
webui-src/src/version.ts
# 图库页构建产物（build_zip.ps1 打包时现场构建，不入库）
pages/moe-paint/

# 临时文件
cm_tmp.txt
_tmp_*
# vite 在构建失败时会残留的配置文件临时副本
webui-src/vite.config.ts.timestamp-*
*_local.zip
.reasonix/
