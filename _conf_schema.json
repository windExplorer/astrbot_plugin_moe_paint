{
  "enabled": {
    "description": "调度总开关",
    "type": "bool",
    "default": true,
    "hint": "关闭后停止定时自动生成；指令 /绘卷 画一张 的手动出图不受影响"
  },
  "comfyui": {
    "description": "ComfyUI 服务器",
    "type": "object",
    "hint": "直连 ComfyUI 的地址与等待预算（与萌绘共用服务器时靠串行+预算避让）",
    "items": {
      "url": {
        "description": "服务器地址",
        "type": "string",
        "default": "http://127.0.0.1:8188",
        "hint": "ComfyUI 的 HTTP 地址，如 http://127.0.0.1:8188 或中转站地址"
      },
      "draw_timeout": {
        "description": "单张基础等待(秒)",
        "type": "int",
        "default": 180,
        "hint": "不含排队的基础等待预算；排队会按下方每任务加时"
      },
      "queue_extra_timeout": {
        "description": "每任务排队加时(秒)",
        "type": "int",
        "default": 60,
        "hint": "队列前方每有一个任务，等待预算加这么多"
      },
      "hard_cap": {
        "description": "等待硬上限(秒)",
        "type": "int",
        "default": 600,
        "hint": "单张等待预算封顶，超过记失败"
      },
      "poll_interval": {
        "description": "轮询间隔(秒)",
        "type": "int",
        "default": 2,
        "hint": "查询出图历史的间隔"
      }
    },
    "default": {}
  },
  "llm": {
    "description": "提示词生成模型",
    "type": "object",
    "hint": "用哪个 LLM 写提示词；留空 provider_id 即用全局默认对话模型",
    "items": {
      "provider_id": {
        "description": "提供商 ID",
        "type": "string",
        "default": "",
        "hint": "AstrBot「模型提供商」列表里的 id；留空 = 全局默认提供商。想用便宜快的模型写提示词就填指定 id"
      },
      "timeout": {
        "description": "调用超时(秒)",
        "type": "int",
        "default": 45,
        "hint": "LLM 生成提示词的超时；失败该轮记 failed，等下一轮调度"
      }
    },
    "default": {}
  },
  "schedule": {
    "description": "定时计划",
    "type": "object",
    "hint": "interval=每 N 小时一张（带抖动）；daily=每天固定时刻列表",
    "items": {
      "mode": {
        "description": "调度模式",
        "type": "string",
        "options": ["interval", "daily"],
        "default": "interval",
        "hint": "interval=固定间隔；daily=每日时刻"
      },
      "interval_hours": {
        "description": "间隔小时",
        "type": "int",
        "default": 6,
        "hint": "interval 模式：每 N 小时一张"
      },
      "jitter_minutes": {
        "description": "抖动分钟",
        "type": "int",
        "default": 30,
        "hint": "interval 模式：间隔上随机加 0~N 分钟，避免整点机械感；daily 模式不生效"
      },
      "daily_times": {
        "description": "每日时刻表",
        "type": "string",
        "default": "09:30,20:00",
        "hint": "daily 模式：逗号分隔的时刻，如 09:30,20:00"
      },
      "quiet_hours": {
        "description": "安静时段",
        "type": "string",
        "default": "01:00-08:00",
        "hint": "此时间段不生成不投递，格式 HH:MM-HH:MM（支持跨零点），留空关闭"
      },
      "max_per_day": {
        "description": "每日上限",
        "type": "int",
        "default": 4,
        "hint": "定时生成每天最多几张（手动 /绘卷 画一张 不受限），0 = 不限"
      },
      "paused_manual": {
        "description": "手动暂停标记",
        "type": "bool",
        "default": false,
        "hint": "由 /绘卷 暂停|继续 与 WebUI 控制，一般不用手改"
      }
    },
    "default": {}
  },
  "workflow_selection": {
    "description": "工作流选择方式",
    "type": "string",
    "options": ["random", "round_robin"],
    "default": "random",
    "hint": "random=每次随机挑一个可用模板；round_robin=按顺序轮换"
  },
  "workflow_templates": {
    "description": "工作流模板清单",
    "type": "template_list",
    "hint": "每个模板 = 一份 ComfyUI API 格式 JSON（放 data/plugin_data/astrbot_plugin_moe_paint/workflows/）+ 这里的元信息。节点定位自动进行（按 KSampler 的 positive/negative/latent_image 引用），定位不了的才填下面的覆盖项",
    "items": {
      "name": {
        "description": "模板名",
        "type": "string",
        "hint": "记录与图库里显示的名字",
        "default": "anima 默认"
      },
      "file": {
        "description": "工作流文件名",
        "type": "string",
        "default": "anima_t2i.json",
        "hint": "data/plugin_data/astrbot_plugin_moe_paint/workflows/ 下的 JSON 文件名（API 格式，ComfyUI「导出 (API)」）；缺 .json 自动补"
      },
      "tag_style": {
        "description": "标签风格",
        "type": "string",
        "options": ["danbooru", "natural"],
        "default": "danbooru",
        "hint": "danbooru=动漫系英文标签（Anima/Illustrious/NoobAI/Pony）；natural=写实系中文自然语言"
      },
      "size_preset": {
        "description": "尺寸预设",
        "type": "string",
        "options": ["sdxl", "flux", "sd15"],
        "default": "sdxl",
        "hint": "横/竖/方分辨率白名单（sdxl: 1216x832 / 832x1216 / 1024x1024 等）"
      },
      "default_negative": {
        "description": "默认负面词",
        "type": "string",
        "default": "",
        "hint": "LLM 没给负面词时用这个；留空则保留工作流 JSON 里写的负向"
      },
      "enabled": {
        "description": "启用",
        "type": "bool",
        "default": true,
        "hint": "只有启用且校验通过的模板参与轮换"
      },
      "positive_node": {
        "description": "正向节点 ID(可选)",
        "type": "string",
        "default": "",
        "hint": "自动定位失败时填正向 CLIPTextEncode 的键名（如 3）"
      },
      "negative_node": {
        "description": "负向节点 ID(可选)",
        "type": "string",
        "default": "",
        "hint": "自动定位失败时填负向文本编码节点的键名（如 4）"
      },
      "latent_node": {
        "description": "Latent 节点 ID(可选)",
        "type": "string",
        "default": "",
        "hint": "自动定位失败时填 EmptyLatentImage 的键名（如 5）"
      },
      "positive_field": {
        "description": "正向输入框名(可选)",
        "type": "string",
        "default": "",
        "hint": "非 text 时必填（Qwen 的 TextEncodeQwenImage21 叫 prompt）"
      },
      "negative_field": {
        "description": "负向输入框名(可选)",
        "type": "string",
        "default": "",
        "hint": "同上"
      }
    },
    "default": [
      {
        "name": "anima 默认",
        "file": "anima_t2i.json",
        "tag_style": "danbooru",
        "size_preset": "sdxl",
        "default_negative": "",
        "enabled": true
      }
    ]
  },
  "theme": {
    "description": "主题词池",
    "type": "object",
    "hint": "多样性抽签的词池扩充与停用（内置 6 大类：风景场景/宇宙星空/美少女/人物肖像/艺术创意/自然生态）",
    "items": {
      "disabled_categories": {
        "description": "停用类别",
        "type": "string",
        "default": "",
        "hint": "逗号分隔的类别名，如 人物肖像,自然生态"
      },
      "extra_words": {
        "description": "词池扩充",
        "type": "dict",
        "default": {},
        "hint": "键=内置类别名（追加题材）或新类别名，或 风格/光色/氛围/构图；值=逗号分隔词。构图项格式 名称@landscape|portrait|square"
      }
    },
    "default": {}
  },
  "delivery": {
    "description": "投递",
    "type": "object",
    "hint": "定时出图投递到哪些会话（显式 opt-in，空 = 只入库不投递）；用 /绘卷 投递 开启 添加",
    "items": {
      "sessions": {
        "description": "投递会话列表",
        "type": "list",
        "items": { "type": "string" },
        "default": [],
        "hint": "会话 UMO 列表；推荐用指令管理：/绘卷 投递 开启"
      },
      "caption_on": {
        "description": "附带文案",
        "type": "bool",
        "default": true,
        "hint": "投递时是否带 LLM 写的一句话文案"
      },
      "caption_template": {
        "description": "文案模板",
        "type": "string",
        "default": "{caption}",
        "hint": "可用占位符：{caption} {category} {subject} {workflow}，如 「{caption}｜{category}」"
      }
    },
    "default": {}
  },
  "gallery": {
    "description": "图库",
    "type": "object",
    "hint": "生成图落盘在 data/plugin_data/astrbot_plugin_moe_paint/gallery（按月分目录）",
    "items": {
      "max_total_mb": {
        "description": "容量上限(MB)",
        "type": "int",
        "default": 1024,
        "hint": "超过按最旧优先淘汰非收藏图（图库里的收藏永不淘汰），0 = 不淘汰"
      }
    },
    "default": {}
  },
  "admin_notify_umo": {
    "description": "管理员通知会话",
    "type": "string",
    "default": "",
    "hint": "连续 3 次生成失败自动暂停时通知谁的 UMO；留空不通知"
  }
}
